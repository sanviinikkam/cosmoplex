# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL=postgresql+asyncpg://cosmoplexx:password@localhost:5432/cosmoplexx

# Redis
REDIS_URL=redis://localhost:6379

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Groq (voice transcription)
GROQ_API_KEY=

# Image generation (fal.ai)
FAL_API_KEY=

# OpenAI fallback via LiteLLM
OPENAI_API_KEY=

# App
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
PASS_THRESHOLD=0.70

# WhatsApp Cloud API (Meta direct) — optional; set to enable the WhatsApp channel
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=cosmoplex-verify
GRAPH_API_VERSION=v21.0
WHATSAPP_TEMPLATES_ENABLED=false
# Meta App Secret — verifies inbound webhook signatures (X-Hub-Signature-256).
# Optional (verification is skipped if unset), but set it before real go-live
# so a spoofed POST to /whatsapp/webhook can't trigger paid AI/voice calls.
WHATSAPP_APP_SECRET=
# High-entropy key for the OPS endpoints (/run-drip, /setup, /register,
# /subscribe, /diag*). These send real messages and change the WhatsApp number,
# so they need a real secret — NOT the semi-public WHATSAPP_VERIFY_TOKEN.
# FAILS CLOSED: if this is empty, all six ops endpoints refuse every request.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_OPS_KEY=

# Public base URL of this backend, e.g. https://cosmoplex-api.onrender.com
# (no trailing slash). Needed so WhatsApp can fetch the certificate PDF.
BACKEND_URL=

# Cloudinary (video hosting + admin uploads)
CLOUDINARY_CLOUD_NAME=dlpl4inio
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin portal (hidden /admin) — single shared password; use a long random value
ADMIN_PASSWORD=change-me-admin
